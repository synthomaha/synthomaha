{
    "name": "synthomaha.net",
    "type": "module",
    "version": "0.1.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "stop": "astro dev stop",
        "commit": "bunx opencommit",
        "build": "bun scripts/build.mjs",
        "preview": "astro preview",
        "deploy": "bun scripts/deploy-cloudflare.mjs",
        "astro": "astro",
        "prepare": "lefthook install || echo 'lefthook not installed (run mise install); git hooks skipped'",
        "generate:logo": "bun run scripts/generate-logo-png.ts",
        "generate:favicons": "bun run scripts/generate-favicons.mjs",
        "generate:avatars": "bun run scripts/generate-avatars.ts",
        "generate": "bun run generate:logo && bun run generate:favicons && bun run generate:avatars",
        "compress:images": "bun scripts/compress-images.ts",
        "check": "astro check",
        "check:content": "astro sync",
        "format": "biome check --write .",
        "lint": "biome check .",
        "lint:migrate": "biome migrate --write",
        "lint:actions": "github-actionlint",
        "test": "bun run build && npm-run-all -l -p check test:unit -s test:e2e:full",
        "test:push": "bun run build && npm-run-all -l -p check test:unit -s test:e2e:smoke",
        "test:unit": "vitest run",
        "test:unit:precommit": "bun run test:unit -- --exclude 'test/build.test.ts'",
        "test:e2e:full": "playwright test --project=mobile-chrome",
        "test:e2e:smoke": "playwright test --project=mobile-chrome site.spec",
        "test:fast": "run-p -l lint test:data",
        "test:ical": "vitest run test/ical.test.ts",
        "test:data": "vitest run test/data.test.ts",
        "test:build": "vitest run test/build.test.ts",
        "test:e2e": "bun run build && playwright test --project=mobile-chrome",
        "test:e2e:desktop": "bun run build && playwright test --project=desktop-chrome",
        "test:e2e:all": "bun run build && playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:a11y": "bun run build && playwright test test/e2e/a11y.spec.js --project=mobile-chrome",
        "test:e2e:lighthouse": "bun run build && unlighthouse-runner --dir dist",
        "audit": "bun audit --audit-level high --production",
        "check:licenses": "check-licenses",
        "check:voidflow": "voidflow check"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "dependencies": {
        "@astrojs/react": "6.0.6",
        "@astrojs/sitemap": "^3.7.4",
        "@awesome.me/webawesome": "^3.14.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/orbitron": "^5.3.0",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.3.5",
        "astro": "^7.4.11",
        "blobshape": "^1.0.0",
        "favicons": "^7.3.1",
        "marked": "^18.2.0",
        "marked-shiki": "^1.2.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rrule": "^2.8.1",
        "tailwindcss": "^4.3.5",
        "unique-names-generator": "^4.7.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@axe-core/playwright": "^4.14.0",
        "@biomejs/biome": "^2.6.7",
        "@lizenz/checker": "^0.0.2",
        "@playwright/test": "^1.65.0",
        "@taraxvoid/voidflow": "^1.2.1",
        "@types/blobshape": "^1.0.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "github-actionlint": "^1.7.12",
        "npm-run-all2": "^9.0.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.12",
        "wrangler": "^4.161.0"
    }
}
